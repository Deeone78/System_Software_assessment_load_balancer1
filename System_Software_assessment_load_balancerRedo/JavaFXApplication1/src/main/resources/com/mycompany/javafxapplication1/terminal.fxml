<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.javafxapplication1.TerminalController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>

        <Label text="Terminal" style="-fx-font-size: 13; -fx-font-weight: bold;" />

        <!-- Output area -->
        <TextArea fx:id="outputArea" prefHeight="330.0" editable="false" wrapText="true"
                  style="-fx-font-family: monospace;" VBox.vgrow="ALWAYS" />

        <!-- Command input -->
        <HBox spacing="8.0">
            <children>
                <Label text="&#36;" />
                <TextField fx:id="commandInput" HBox.hgrow="ALWAYS" onAction="#handleEnter"
                           promptText="Type a command and press Enter" />
                <Button text="Run" onAction="#handleEnter" />
            </children>
        </HBox>

    </children>
</VBox>
